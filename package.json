{
  "name": "dsh-plugin-recommend",
  "version": "1.1.0",
  "description": "Plugin recommender for DeepSeek Harness: search and rank DSH plugins from an embedded marketplace catalog by need description, category and tags, with scored match breakdowns, repo deduplication, per-category diversity, nearest-alternative suggestions, and a live catalog refresh from the awesome-dsh-plugin README",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./verify": "./lib/verify.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "test": "node test/recommend.test.mjs",
    "prepublishOnly": "node test/recommend.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "recommend",
    "marketplace",
    "catalog",
    "search",
    "rank",
    "discovery"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/863683348/dsh-plugin-recommend.git"
  },
  "homepage": "https://github.com/863683348/dsh-plugin-recommend#readme",
  "bugs": {
    "url": "https://github.com/863683348/dsh-plugin-recommend/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
